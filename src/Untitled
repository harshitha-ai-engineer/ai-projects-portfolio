
"""
Enterprise AI Platform
Core Configuration Module
"""

import os
from pathlib import Path
from dotenv import load_dotenv


# Project root directory
BASE_DIR = Path(__file__).resolve().parent.parent

# Load environment variables
ENV_FILE = BASE_DIR / ".env"
load_dotenv(dotenv_path=ENV_FILE)


class AppConfig:

    # Application Information
    APP_NAME = "Enterprise AI Platform"
    APP_VERSION = "1.0.0"

    # Environment Configuration
    ENVIRONMENT = os.getenv("APP_ENV", "development")

    DEBUG = os.getenv(
        "DEBUG", "false"
    ).strip().lower() == "true"

    # AI Provider Configuration
    AI_PROVIDER = os.getenv("AI_PROVIDER", "openai")

    API_KEY = os.getenv("API_KEY", "")

    # API Information
    API_TITLE = "Enterprise AI Platform API"

    API_DESCRIPTION = (
        "An enterprise-grade AI platform "
        "for intelligent document processing "
        "and AI-powered automation."
    )

    # Supported Environments
    SUPPORTED_ENVIRONMENTS = (
        "development",
        "testing",
        "production"
    )

    # Configuration Validation
    @classmethod
    def validate(cls):

        if cls.ENVIRONMENT not in cls.SUPPORTED_ENVIRONMENTS:
            raise ValueError("Invalid environment")

        if cls.ENVIRONMENT == "production" and cls.DEBUG:
            raise ValueError(
                "Debug mode must be disabled in production"
            )

        if not cls.AI_PROVIDER:
            raise ValueError("AI_PROVIDER cannot be empty")

        return True
